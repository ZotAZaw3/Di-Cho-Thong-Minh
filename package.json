{
  "name": "di-cho-thong-minh-backend",
  "version": "0.2.0",
  "private": true,
  "description": "API server cho app Đi chợ tiện lợi (IT4788, nhóm 4)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed -- --demo",
    "docs:export": "node scripts/export-api-docs.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "swagger-ui-dist": "5.17.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
