# Copy thành .env rồi điền giá trị. KHÔNG commit file .env.
PORT=3000
API_PREFIX=/it4788
# 1 khi chạy sau Nginx (VPS), 0 khi chạy local
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# Postgres. Supabase: pooler 6543 cho app, direct 5432 cho migration.
# Local: postgresql://postgres:postgres@localhost:5432/dicho
DATABASE_URL=
DIRECT_URL=

# Đăng nhập: local (tự lưu mật khẩu, mã xác minh in ra log) hoặc supabase (Supabase Auth gửi mail OTP)
AUTH_DRIVER=local
# Bắt buộc khi AUTH_DRIVER=local ở production (chuỗi ngẫu nhiên ≥ 16 ký tự)
JWT_SECRET=
# local: true thì đăng ký xong dùng được ngay, không cần nhập mã
LOCAL_AUTO_CONFIRM=false

# Supabase (bắt buộc khi AUTH_DRIVER=supabase hoặc STORAGE_DRIVER=supabase). Service role key chỉ nằm trên server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ảnh: local (thư mục UPLOAD_DIR) hoặc supabase (bucket public SUPABASE_STORAGE_BUCKET, tạo trước trên Dashboard)
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=images
UPLOAD_DIR=uploads
# URL công khai của server, dùng để tạo link ảnh khi STORAGE_DRIVER=local (vd. https://abc.def)
PUBLIC_BASE_URL=

# Thông báo: log (chỉ in ra console) hoặc fcm (cần file service account JSON, để ngoài repo)
PUSH_DRIVER=log
FIREBASE_SERVICE_ACCOUNT_PATH=

# Job nhắc hết hạn (hằng ngày) và worker gửi thông báo (mỗi phút)
ENABLE_JOBS=true
EXPIRY_CRON=0 8 * * *
DISPATCH_CRON=* * * * *
EXPIRY_DAYS=3
LOG_RETENTION_DAYS=30
