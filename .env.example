# Copy thành .env rồi điền giá trị. KHÔNG commit file .env.
PORT=3000
API_PREFIX=/it4788
# 1 khi chạy sau Nginx (VPS), 0 khi chạy local
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Supabase Postgres (GĐ1): pooler 6543 cho app, direct 5432 cho prisma migrate
DATABASE_URL=
DIRECT_URL=

# Supabase Auth + Storage (GĐ2): service role key chỉ nằm trên server
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin (GĐ4): đường dẫn tới file service account JSON, để ngoài repo
FIREBASE_SERVICE_ACCOUNT_PATH=
